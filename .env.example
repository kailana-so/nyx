# nyx_v1 environment template — copy to .env and fill in.

# ── Identity ────────────────────────────────────────────────────────────────
# Default scope on this machine. Set "personal" at home, "work" at the office.
# Every nyx command accepts --profile <other> to cross-fetch from the other scope.
NYX_PROFILE=personal

# Active project for this machine. Mutated by `nyx projects -sw <name>`.
NYX_PROJECT=misc

# Where nyx looks up project filesystem roots when a project doesn't have
# an explicit root configured in ~/.nyx/project_config.json. Defaults to ~/Documents.
# NYX_PROJECT_DIR=$HOME/Documents

# ── Anthropic (chat / advisor / learn) ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase (memory backbone — shared across machines) ─────────────────────
# Same project for personal + work; rows scoped by NYX_PROFILE.
SUPABASE_URL=
SUPABASE_KEY=

# ── Voyage AI (embeddings) ──────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── AWS Bedrock (chat / learn / code / plan agents) ─────────────────────────
# AWS credentials profile — must be configured via `aws configure --profile <name>`.
# AWS_PROFILE=bedrock-dev
# AWS_REGION=ap-southeast-2
# Override the default Bedrock model IDs to swap to a different model.
# BEDROCK_ADVISOR_MODEL=qwen.qwen3-235b-a22b-2507-v1:0

# ── Ollama (local Qwen3 for nyx chat/learn --local) ──────────────────────────
# Defaults work for a local Ollama install — uncomment to override.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:14b
